# Generated data
# =========================

# Ignore all generated data by default
/data/


# =========================
# Evaluation data whitelist
# =========================

# Keep evaluation directory itself
!/data/eval/

# Allow only small evaluation jsonl files by default
!/data/eval/*.jsonl


# =========================
# Never commit large training pools
# =========================

/data/eval/jd_train_pool_*.jsonl
/data/eval/match_train_pool_*.jsonl
/data/eval/resume_train_pool_*.jsonl

/data/eval/public_jd_candidate_pool.jsonl
/data/eval/resume_manual_eval_augmented.jsonl


